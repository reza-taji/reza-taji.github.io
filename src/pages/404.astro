---
// 404.astro — Astro emits dist/404.html automatically. GitHub Pages serves
// it for unknown paths; since this site is fully static (every real page is
// pre-rendered), a plain friendly 404 is all we need — no SPA redirect hack.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="صفحه یافت نشد"
  description="صفحه‌ای که به دنبال آن بودید یافت نشد. به فهرست کتاب‌های نشر مکتب ابوتراب بازگردید."
  path="/404"
>
  <div class="mx-auto max-w-2xl px-4 py-20 text-center md:px-6">
    <p class="text-6xl font-extrabold text-neutral-200">۴۰۴</p>
    <h1 class="mt-4 text-2xl font-bold">صفحه یافت نشد</h1>
    <p class="mt-3 text-neutral-500">
      صفحه‌ای که به دنبال آن بودید وجود ندارد یا جابه‌جا شده است.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-neutral-900 px-6 py-3 font-semibold text-white transition hover:bg-neutral-700"
      >
        بازگشت به خانه
      </a>
      <a
        href="/books"
        class="rounded-full border border-neutral-300 px-6 py-3 font-semibold text-neutral-900 transition hover:bg-neutral-100"
      >
        فهرست کتاب‌ها
      </a>
    </div>
  </div>
</Layout>
