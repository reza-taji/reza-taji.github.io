---
import Layout from '../layouts/Layout.astro';
import ContactCards from '../components/ContactCards.astro';
import { publishingFields, collaborationFields, submissionSteps } from '../config.ts';
import { authorMessage, collaborationMessage, generalMessage, getBaleUrl } from '../utils/bale.ts';
---

<Layout>
  <section class="hero-section">
    <div class="site-container grid items-center gap-12 py-16 lg:grid-cols-[1.25fr_1fr] lg:py-24">
      <div>
        <p class="eyebrow">نشر مکتب ابوتراب · آغاز یک مسیر فرهنگی</p>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.7] sm:text-5xl sm:leading-[1.65]">برای اندیشه‌ای که<br /><span class="text-teal-800">شایسته شنیدن است.</span></h1>
        <p class="mt-6 max-w-xl text-lg leading-9 text-neutral-600">نویسندگان، اندیشمندان و پژوهشگران گرامی؛ به خانه تازه نشر مکتب ابوتراب خوش آمدید. از نخستین طرح تا انتشار اثر، گفتگو را با شما آغاز می‌کنیم.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button button-primary" href="/submit-manuscript/">ارسال اثر و ارتباط مؤلفین <span aria-hidden="true">←</span></a>
          <a class="button button-outline" href={getBaleUrl(generalMessage)} target="_blank" rel="noopener noreferrer">گفتگو با مدیر نشر در بله ↗</a>
        </div>
        <p class="mt-6 text-sm text-neutral-500">انتشار علمی و فرهنگی، با احترام به اندیشه و حقوق پدیدآورنده</p>
      </div>
      <div class="brand-art" aria-hidden="true">
        <div class="brand-art-inner"><span class="text-sm tracking-widest text-white/60">مکتب ابوتراب</span><div class="art-mark">اندیشه<br /><span>به روایت قلم</span></div><div class="art-line"></div><span class="text-sm text-white/70">پژوهش · فرهنگ · گفت‌وگو</span></div>
        <span class="art-caption">هر اثر ماندگار، با یک گفتگو آغاز می‌شود.</span>
      </div>
    </div>
  </section>

  <section id="manuscript" class="section-space site-container" aria-labelledby="manuscript-title">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.4fr]">
      <div><p class="eyebrow">۰۱ / همراه مؤلفین</p><h2 id="manuscript-title" class="section-title">از طرح شما،<br />تا اثر ماندگار</h2><p class="section-copy">اگر در حوزه‌های علمی، علوم انسانی، فرهنگ و معارف اسلامی تألیف یا ترجمه‌ای دارید، خوشحال می‌شویم با ایده شما آشنا شویم. بررسی اولیه به معنای پذیرش قطعی یا تعهد به انتشار نیست.</p><a class="text-link mt-5 inline-block" href="/submit-manuscript/">راهنمای کامل ارسال اثر ←</a></div>
      <div class="panel bg-white"><h3 class="text-lg font-bold">مسیر ارسال و بررسی اثر</h3><ol class="mt-6 grid gap-6 sm:grid-cols-2">{submissionSteps.map((step, index) => <li><span class="step-number">{new Intl.NumberFormat('fa-IR').format(index + 1)}</span><h4 class="mt-3 font-bold">{step.title}</h4><p class="mt-2 text-sm leading-7 text-neutral-600">{step.text}</p></li>)}</ol><a class="button button-bale mt-8" href={getBaleUrl(authorMessage)} target="_blank" rel="noopener noreferrer">ارسال طرح اثر از طریق بله ↗</a></div>
    </div>
  </section>

  <section id="collaboration" class="collaboration-section section-space" aria-labelledby="collaboration-title">
    <div class="site-container grid items-center gap-10 lg:grid-cols-2">
      <div><p class="eyebrow text-emerald-300">۰۲ / خانواده نشر</p><h2 id="collaboration-title" class="section-title text-white">با تخصص شما،<br />مسیر نشر کامل‌تر می‌شود.</h2><p class="mt-5 leading-9 text-white/75">از ویراستاران، صفحه‌آرایان، طراحان جلد، مترجمان و پژوهشگران دعوت می‌کنیم همراه ما باشند. پایه همکاری ما گفتگوی روشن، احترام متقابل و توافق درباره محدوده کار، زمان و دستمزد هر پروژه است.</p><div class="mt-7 flex flex-wrap gap-3"><a class="button button-bale" href={getBaleUrl(collaborationMessage)} target="_blank" rel="noopener noreferrer">اعلام آمادگی برای همکاری در بله ↗</a><a class="button button-light-outline" href="/collaboration/">آشنایی با زمینه‌های همکاری</a></div></div>
      <ul class="grid gap-3">{collaborationFields.map((field, index) => <li class="flex items-center gap-4 rounded-2xl border border-white/20 px-6 py-5"><span class="text-emerald-300" aria-hidden="true">{new Intl.NumberFormat('fa-IR').format(index + 1).padStart(2, '۰')}</span><span class="font-medium text-white">{field}</span></li>)}</ul>
    </div>
  </section>

  <section id="about" class="section-space site-container" aria-labelledby="about-title">
    <div class="grid gap-10 lg:grid-cols-2"><div><p class="eyebrow">۰۳ / درباره نشر</p><h2 id="about-title" class="section-title">خانه‌ای برای<br />اندیشه، پژوهش و فرهنگ</h2><p class="section-copy">نشر مکتب ابوتراب مجموعه‌ای تازه‌تأسیس است که با هدف همراهی با پدیدآورندگان و گسترش دسترسی به آثار علمی و فرهنگی شکل گرفته است. در آغاز این مسیر، تمرکز ما بر شناخت آثار ارزشمند و شکل‌دادن به شبکه‌ای از همکاران متخصص است.</p><p class="section-copy">هنوز کتابی منتشر نکرده‌ایم؛ اینجا فضایی برای معرفی نشر و آغاز گفتگو درباره آثار و همکاری‌های آینده است.</p></div><div class="panel"><h3 class="text-xl font-bold">افق‌های پیش روی ما</h3><ul class="mt-6 space-y-4">{publishingFields.map((field) => <li class="border-b border-neutral-200 pb-4 flex items-center gap-3"><span class="text-teal-700" aria-hidden="true">✦</span>{field}</li>)}</ul><p class="mt-6 text-sm leading-7 text-neutral-600">دقت علمی، کیفیت زبان و طراحی، و احترام به حقوق مؤلف و مترجم، اصولی است که می‌خواهیم مسیرمان را بر آن بنا کنیم.</p></div></div>
  </section>

  <section id="contact" class="section-space bg-white" aria-labelledby="contact-title"><div class="site-container"><p class="eyebrow">۰۴ / آغاز گفتگو</p><div class="mb-8 flex flex-wrap items-end justify-between gap-4"><h2 id="contact-title" class="section-title">راه‌های ارتباطی</h2><a class="text-link" href="/contact/">صفحه تماس با ما ←</a></div><ContactCards /></div></section>
</Layout>
