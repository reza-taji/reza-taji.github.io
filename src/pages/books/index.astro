---
// books/index.astro — full catalog listing page.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BookCard from '../../components/BookCard.astro';

const books = (await getCollection('books')).sort(
  (a, b) => b.data.publishYear - a.data.publishYear,
);
---

<Layout
  title="فهرست کتاب‌ها"
  description="فهرست کامل کتاب‌های نشر مکتب ابوتراب — آثار پژوهشی و فرهنگی با امکان سفارش از طریق پیام‌رسان بله."
  path="/books"
>
  <div class="mx-auto max-w-6xl px-4 py-12 md:px-6 md:py-16">
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold md:text-4xl">فهرست کتاب‌ها</h1>
      <p class="mt-2 text-neutral-500">
        {new Intl.NumberFormat('fa-IR').format(books.length)} عنوان
      </p>
    </header>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {books.map((book) => <BookCard book={book} />)}
    </div>
  </div>
</Layout>
