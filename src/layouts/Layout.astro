---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import { PUBLISHER, SITE_DESCRIPTION, SITE_TITLE } from '../config.ts';
import { generalMessage, getBaleUrl } from '../utils/bale.ts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  noindex?: boolean;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, path = Astro.url.pathname, noindex = false } = Astro.props;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${PUBLISHER.site}/#organization`,
  name: PUBLISHER.name,
  alternateName: ['نشر مکتب ابوتراب','انتشارات مکتب ابوتراب','Matpub', 'MaktabeAbutorab Publication'],
  url: PUBLISHER.site,
  logo: new URL(PUBLISHER.logoUrl, PUBLISHER.site).href,
  description: SITE_DESCRIPTION,
  ...(PUBLISHER.email ? { email: PUBLISHER.email } : {}),
  ...(PUBLISHER.phone ? { telephone: PUBLISHER.phone } : {}),
  ...(PUBLISHER.baleChannelUrl ? { sameAs: [PUBLISHER.baleChannelUrl] } : {}),
};
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={PUBLISHER.logoUrl} />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} path={path} schema={organization} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <Header />
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="site-container grid gap-10 py-14 md:grid-cols-3">
        <div>
          <a href="/" class="flex items-center gap-3 font-bold text-xl"><img src={PUBLISHER.logoUrl} alt="" width="44" height="44" />{PUBLISHER.name}</a>
          <p class="mt-5 text-sm leading-8 text-white/70">مسیر تازه‌ای برای پیوند اندیشه و خواننده؛ همراه نویسندگان، مترجمان و خانواده نشر.</p>
        </div>
        <nav aria-label="پیوندهای پاورقی">
          <h2 class="font-bold">همراه نشر</h2>
          <ul class="mt-4 space-y-3 text-sm text-white/75">
            <li><a href="/submit-manuscript/">ارسال اثر و مؤلفین</a></li>
            <li><a href="/collaboration/">همکاری با ما</a></li>
            <li><a href="/#about">درباره انتشارات</a></li>
            <li><a href="/contact/">تماس با ما</a></li>
          </ul>
        </nav>
        <div>
          <h2 class="font-bold">در ارتباط بمانیم</h2>
          <a href={getBaleUrl(generalMessage)} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-sm text-emerald-300">گفتگو در بله ↗</a>
          {PUBLISHER.baleChannelUrl ? <a href={PUBLISHER.baleChannelUrl} target="_blank" rel="noopener noreferrer" class="mt-3 block text-sm text-white/75">کانال رسمی بله ↗</a> : <p class="mt-3 text-sm text-white/60">کانال رسمی: به‌زودی</p>}
          {PUBLISHER.email && <a class="mt-3 block text-sm" href={`mailto:${PUBLISHER.email}`}><bdi>{PUBLISHER.email}</bdi></a>}
          {PUBLISHER.phone && <a class="mt-3 block text-sm" href={`tel:${PUBLISHER.phone}`}><bdi>{PUBLISHER.phone}</bdi></a>}
        </div>
      </div>
      <div class="site-container border-t border-white/15 py-6 text-sm text-white/60">© {new Intl.DateTimeFormat('fa-IR', { year: 'numeric' }).format(new Date())} نشر مکتب ابوتراب. تمامی حقوق محفوظ است.</div>
    </footer>
  </body>
</html>
