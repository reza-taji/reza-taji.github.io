---
// Layout.astro — RTL HTML5 shell shared by every page. Includes the SEO head,
// global stylesheet, site header (logo + nav) and footer (Bale channel).
import '../styles/global.css';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  path?: string;
  schema?: object | object[];
  type?: 'website' | 'book';
}

const props = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...props} />
  </head>
  <body class="flex min-h-screen flex-col bg-white text-neutral-900">
    <!-- Header -->
    <header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 md:h-18 md:px-6">
        <a href="/" class="flex items-center gap-2 text-neutral-900">
          <img src="/logo.webp" alt="لوگوی نشر مکتب ابوتراب" width="40" height="40" class="object-contain" />
          <span class="hidden text-lg font-bold sm:inline">نشر مکتب ابوتراب</span>
        </a>
        <nav aria-label="ناوبری اصلی">
          <ul class="flex items-center gap-1 text-sm font-medium md:gap-2">
            <li><a class="rounded-full px-3 py-2 transition hover:bg-neutral-100" href="/">خانه</a></li>
            <li><a class="rounded-full px-3 py-2 transition hover:bg-neutral-100" href="/books">کتاب‌ها</a></li>
            <li><a class="rounded-full px-3 py-2 transition hover:bg-neutral-100" href="/#contact">تماس</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Page content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto bg-neutral-900 py-8 text-neutral-100">
      <div class="mx-auto max-w-6xl px-4 md:px-6">
        <div class="flex flex-col items-center justify-between gap-4 text-center md:flex-row md:text-right">
          <div>
            <p class="font-semibold">نشر مکتب ابوتراب</p>
            <p class="text-sm text-neutral-400">تمامی حقوق محفوظ است.</p>
          </div>
          <nav aria-label="پیوندهای پاورقی">
            <ul class="flex flex-wrap justify-center gap-6 text-sm">
              <li><a class="transition hover:text-white" href="/">خانه</a></li>
              <li><a class="transition hover:text-white" href="/books">کتاب‌ها</a></li>
              <li>
                <a class="transition hover:text-white" href="https://ble.ir/AbutorabChannel" target="_blank" rel="noopener noreferrer">
                  کانال بله
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <hr class="my-6 border-neutral-700" />
        <p class="text-center text-xs text-neutral-500">
          © {new Date().getFullYear()} نشر مکتب ابوتراب
        </p>
      </div>
    </footer>
  </body>
</html>
