---
import { PUBLISHER } from '../config.ts';

interface Props {
  title: string;
  description: string;
  image?: string;
  path?: string;
  schema?: object;
  noindex?: boolean;
}

const { title, description, image, path = Astro.url.pathname, schema, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(PUBLISHER.site);
const canonical = new URL(path, site).href;
const imageUrl = image ? new URL(image, site).href : undefined;
const pageTitle = title.includes(PUBLISHER.name) ? title : `${title} | ${PUBLISHER.name}`;
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.origin}/#website`,
  name: PUBLISHER.name,
  url: site.href,
  inLanguage: 'fa-IR',
  publisher: { '@id': `${site.origin}/#organization` },
};
const schemas = schema ? [website, schema] : [website];
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={PUBLISHER.name} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta name="theme-color" content="#123d37" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={PUBLISHER.name} />
<meta property="og:locale" content="fa_IR" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imageUrl && <><meta property="og:image" content={imageUrl} /><meta property="og:image:alt" content={title} /></>}
<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{schemas.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry).replace(/</g, '\\u003c')} />)}
