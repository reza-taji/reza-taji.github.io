---
// SEO.astro — full head tag suite: standard meta, OpenGraph, Twitter Cards,
// canonical URL, and JSON-LD structured data. Pure Astro = zero client JS.
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  // Optional absolute path (e.g. "/books/book-1") for canonical + OG URLs.
  path?: string;
  // Pre-built JSON-LD object(s); omitted when not provided.
  schema?: object | object[];
  // One of: 'website' (default) or 'book'.
  type?: 'website' | 'book';
}

const {
  title,
  description,
  image = '/og-default.webp',
  path = '/',
  schema,
  type = 'website',
} = Astro.props;

const site = Astro.site ?? new URL('https://abutorab-pub.ir');
const canonical = new URL(path, site).href;
const imageUrl = new URL(image, site).href;
const pageTitle = `${title} | نشر مکتب ابوتراب`;

// JSON-LD: caller-provided schema wins; otherwise emit a WebSite node so
// every page (even non-book ones) carries some structured data.
const schemas: object[] = schema
  ? Array.isArray(schema) ? schema : [schema]
  : [
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'نشر مکتب ابوتراب',
        url: site.href,
        inLanguage: 'fa-IR',
      },
    ];
---

<!-- Primary meta -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="نشر مکتب ابوتراب" />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#111111" />

<!-- OpenGraph -->
<meta property="og:type" content={type === 'book' ? 'book' : 'website'} />
<meta property="og:site_name" content="نشر مکتب ابوتراب" />
<meta property="og:locale" content="fa_IR" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={title} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />

<!-- JSON-LD structured data -->
{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
