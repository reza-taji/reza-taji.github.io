---
import { PUBLISHER } from '../config.ts';
import { BALE_ID, generalMessage, getBaleUrl } from '../utils/bale.ts';
---

<div class="grid gap-5 md:grid-cols-3">
  <article class="panel">
    <span class="eyebrow">گفتگوی مستقیم</span>
    <h3 class="mt-3 text-xl font-bold">پیام‌رسان بله</h3>
    <p class="mt-3 text-neutral-600">برای ارسال اثر، معرفی تخصص یا پرسش درباره نشر، گفتگو را از اینجا آغاز کنید.</p>
    <p class="mt-3"><bdi dir="ltr">@{BALE_ID}</bdi></p>
    <a class="text-link mt-5 inline-block" href={getBaleUrl(generalMessage)} target="_blank" rel="noopener noreferrer">گفتگو در بله ↗</a>
    {PUBLISHER.baleChannelPageUrl ? <a class="text-link mt-3 block" href={PUBLISHER.baleChannelPageUrl} target="_blank" rel="noopener noreferrer">کانال رسمی نشر ↗</a> : <p class="mt-3 text-sm text-neutral-500">نشانی کانال رسمی به‌زودی اعلام می‌شود.</p>}
  </article>
  <article class="panel">
    <span class="eyebrow">مکاتبات نشر</span>
    <h3 class="mt-3 text-xl font-bold">ایمیل انتشارات</h3>
    {PUBLISHER.email ? <a class="text-link mt-5 inline-block" href={`mailto:${PUBLISHER.email}`}><bdi dir="ltr">{PUBLISHER.email}</bdi></a> : <p class="mt-3 text-neutral-600">ایمیل رسمی به‌زودی اعلام می‌شود. در حال حاضر از طریق بله در ارتباط باشید.</p>}
  </article>
  <article class="panel">
    <span class="eyebrow">تماس و پیامک</span>
    <h3 class="mt-3 text-xl font-bold">شماره تماس</h3>
    {PUBLISHER.phone ? <div class="mt-5 flex flex-wrap gap-4"><a class="text-link" href={`tel:${PUBLISHER.phone}`}><bdi dir="ltr">{PUBLISHER.phone}</bdi></a><a class="text-link" href={`sms:${PUBLISHER.phone}`}>ارسال پیامک</a></div> : <p class="mt-3 text-neutral-600">شماره رسمی به‌زودی اعلام می‌شود. برای هماهنگی اولیه در بله پیام بگذارید.</p>}
  </article>
</div>
